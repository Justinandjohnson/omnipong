# ── OmniPong Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# ── Stadium League credentials (for scraper) ─────────────────────────────────
OMNIPONG_USER=your_stadium_username
OMNIPONG_PASS=your_stadium_password
STADIUM_USER=your_email@example.com
STADIUM_PASS=your_stadium_password

# ── AI / Voice APIs ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
DEEPGRAM_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Twilio (scorekeeper SMS) ──────────────────────────────────────────────────
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
TWILIO_ACCOUNT_SID=AC...
TWILIO_PHONE_NUMBER=+1...

# ── Personal (admin-only features) ───────────────────────────────────────────
# Leave blank to disable admin-mode features
USER_PHONE_NUMBER=+1...

# ── Database ──────────────────────────────────────────────────────────────────
# Uncomment and set for PostgreSQL (Render/Railway). Falls back to local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname

# ═══════════════════════════════════════════════════════════════════════════
# Rubberr Agent Platform — Phase 2 unified config (docs/RELAY_ARCHITECTURE.md,
# docs/PLATFORM_RUNBOOK.md). Every knob below is read via os.getenv/os.environ
# by relay/config.py, rubberr/backend/main.py, or companion/companion.py —
# grep the var name if you need the exact call site.

# ── Relay (Y6) — rubberr/backend/main.py, companion/companion.py ───────────────
# Base URL the backend + companion use to reach the relay server.
#   Backend (rubberr/backend/main.py) uses http(s):// for its POST/GET calls.
#   Companion (companion/companion.py --relay-base-url) uses ws(s)://.
RELAY_BASE_URL=https://relay.rubberr.example.com

# The OWNER's own companion's register_token (relay/register_tokens.json maps
# this -> a user_id). Used by rubberr/backend/main.py's Tier-3 endpoints
# (/tools/sync/stadium, /tools/sync/omnipong) to mint a fresh relay
# session_token via POST /session/start before each private sync run. This is
# the SAME token you pass to `python companion/companion.py --register-token`
# when you launch your own companion (see docs/PLATFORM_RUNBOOK.md).
RELAY_REGISTER_TOKEN=rt_owner_...

# The always-on PUBLIC companion's register_token — a companion+browser
# instance running on Y6 with no personal login, used only for the
# Cloudflare-walled Tier-1 USATT lookup (GET /tools/lookup/usatt). A fresh
# session_token is minted from this per lookup (relay sessions have a TTL —
# see RELAY_MAX_TTL_S below — so this is never a long-lived static token).
# Leave unset to disable Tier-1 lookup with a clean 503 (no fake data).
RELAY_PUBLIC_REGISTER_TOKEN=rt_public_...

# S3 hardening — owner-only posture. The relay's control endpoints
# (/session/start, /session/stop, /session/gate) refuse any caller that
# doesn't present this exact value in the X-Operator-Token header. Set on the
# relay host (Y6) AND on any host whose backend calls the relay
# (rubberr/backend/main.py sends it via _provision_relay_session /
# _stop_relay_session). Leave unset and the relay fails CLOSED — control
# endpoints return 503, never run open. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
RELAY_OPERATOR_TOKEN=op_...

# Relay server's own knobs (relay/config.py) — only needed on the host that
# actually runs `uvicorn relay.server:app` (Y6). Defaults shown.
RELAY_HOST=0.0.0.0
RELAY_PORT=8765
RELAY_IDLE_TTL_S=120
RELAY_MAX_TTL_S=900
RELAY_GATE_TTL_S=300
# C4: also read directly by rubberr/backend/browser_agent.py (its own
# GATE_TTL_S default) so relay and browser-agent never drift on this value —
# keep this one env var as the single source of truth for both.
RELAY_HEARTBEAT_INTERVAL_S=20
RELAY_COMPANION_RPC_TIMEOUT_S=10
# Path to the {register_token: user_id} JSON map the relay loads at startup.
# Defaults to relay/register_tokens.json next to relay/config.py.
# RELAY_REGISTER_TOKENS_FILE=/path/to/register_tokens.json

# ── Browser agent (Agent B) — rubberr/backend/browser_agent.py via main.py ──────
# BYOK: the user's own OpenRouter key, sent from the frontend as
# X-User-Api-Key and never stored server-side — nothing to configure here.
# Model default (overridable per-request from the frontend):
BROWSER_AGENT_MODEL=google/gemini-3-pro-preview

# ── Companion (user's machine or Y6, for the public companion) ──────────────────
# Not read from .env by companion/companion.py today — passed as CLI flags:
#   python companion/companion.py --relay-base-url wss://... --register-token rt_...
# Documented here so both knobs live in one place; see docs/PLATFORM_RUNBOOK.md.

# S2-profile hardening: overrides where the companion's DEDICATED, rubberr-only
# Chrome profile lives (companion/chrome.py: dedicated_profile_dir()). Leave
# unset to use the per-OS default (~/Library/Application Support/rubberr/
# chrome-profile on macOS, %LOCALAPPDATA%\rubberr\chrome-profile on Windows).
# This is NEVER the user's real/default Chrome profile — see companion/README.md.
# RUBBERR_CHROME_PROFILE_DIR=/path/to/dedicated/chrome-profile

# ── Rubberr backend (Agent F) — rubberr/backend/main.py ─────────────────────────
PLAYER_NAME=your_display_name
PLAYER_FULL_NAME=Your Full Name
RUBBERR_API_KEY=

# S1 hardening — owner-only gate (main.py's _require_operator_token) on the
# Tier-3 sync + Tier-1 lookup endpoints: POST /tools/sync/stadium,
# GET /tools/sync/stadium/events/{id}, POST /tools/sync/omnipong,
# GET /tools/sync/omnipong/events/{id}, GET /tools/lookup/usatt. These drive
# a REAL browser through the relay, so they must never be reachable
# anonymously. Required header on every call: X-Operator-Token: <this value>
# (the frontend sends it automatically — see rubberr/frontend/.env.local's
# NEXT_PUBLIC_OPERATOR_TOKEN, same value). Leave unset and these endpoints
# fail CLOSED with a 503 — they never silently run open. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
OPERATOR_TOKEN=op_...

# ── Tier-2 public feed (Agent D) — feed/, reuses OMNIPONG_USER/OMNIPONG_PASS above
# Where feed/api.py reads its sanitized snapshot from (defaults next to feed/).
# FEED_DATA_PATH=/path/to/feed_data.json

# ── Rubberr frontend (Agent E) — rubberr/frontend/.env.local, NOT this file ─────
# Next.js only reads NEXT_PUBLIC_* vars that are present at build time, from
# rubberr/frontend/.env.local (see rubberr/frontend/ for its own example) —
# listed here only so the full knob set is discoverable in one place:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
