# ── OmniPong Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# ── Stadium League credentials (for scraper) ─────────────────────────────────
OMNIPONG_USER=your_stadium_username
OMNIPONG_PASS=your_stadium_password
STADIUM_USER=your_email@example.com
STADIUM_PASS=your_stadium_password

# ── AI / Voice APIs ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
DEEPGRAM_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Twilio (scorekeeper SMS) ──────────────────────────────────────────────────
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
TWILIO_ACCOUNT_SID=AC...
TWILIO_PHONE_NUMBER=+1...

# ── Personal (admin-only features) ───────────────────────────────────────────
# Leave blank to disable admin-mode features
USER_PHONE_NUMBER=+1...

# ── Database ──────────────────────────────────────────────────────────────────
# Uncomment and set for PostgreSQL (Render/Railway). Falls back to local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname
