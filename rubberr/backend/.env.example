# Anthropic (required — used for /chat and /players/*/scouting)
ANTHROPIC_API_KEY=

# Database (optional — defaults to local SQLite if unset)
DATABASE_URL=

# Simple API key for AI endpoints (optional but recommended in production)
# Set this and pass X-Api-Key: <value> in requests to /chat and /players/*/scouting
RUBBERR_API_KEY=

# Twilio (optional — required only for SMS practice reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# User contact (optional — required for SMS reminders)
USER_PHONE_NUMBER=
