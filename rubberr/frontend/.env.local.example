# ── Rubberr Frontend Environment Variables ───────────────────────────────────
# Copy this file to .env.local and fill in your values.

# Backend API URL
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Render):
# NEXT_PUBLIC_API_URL=https://omnipong-backend.onrender.com

# S1 hardening — owner-only gate on the Tier-3 sync + Tier-1 lookup
# endpoints (/tools/sync/stadium, /tools/sync/omnipong, /tools/lookup/usatt).
# Must match OPERATOR_TOKEN on the backend (root .env). A build-time
# NEXT_PUBLIC_ var is acceptable here ONLY because this is an owner-only,
# self-hosted single-user deployment — it ships in the client bundle, so
# never reuse this value for anything meant to stay secret from the browser.
NEXT_PUBLIC_OPERATOR_TOKEN=op_...
